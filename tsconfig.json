{
  "include": ["src"],
  "compilerOptions": {
    "target": "ES2025",
    "module": "NodeNext",
    "lib": ["ES2025", "DOM"],
    "types": [],
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist"
  }
}
